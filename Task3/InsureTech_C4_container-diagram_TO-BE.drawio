        <mxCell id="comment1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=10;align=left;verticalAlign=top;dashed=1" value="💡 Transactional Outbox Pattern:&#xa;1. Сохранение в DB + запись в outbox (1 транзакция)&#xa;2. Background worker публикует в Kafka&#xa;3. Гарантия: no data loss, exactly-once" vertex="1">
          <mxGeometry height="60" width="270" x="1230" y="880" as="geometry" />
        </mxCell>
        <mxCell id="comment2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=10;align=left;verticalAlign=top;dashed=1" value="💡 Local Replicas (CQRS Read Model):&#xa;• core-app: local_products_replica&#xa;• settlement: local_products_replica + local_policies_replica&#xa;Преимущества: 0 latency, нет зависимостей" vertex="1">
          <mxGeometry height="60" width="230" x="630" y="900" as="geometry" />
        </mxCell>
        <mxCell id="comment3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=10;align=left;verticalAlign=top;dashed=1" value="💡 Event-Driven Benefits:&#xa;• Асинхронность: no cascading failures&#xa;• Масштабируемость: consumer groups&#xa;• Resilience: retry, dead-letter queues&#xa;• Audit: event log сохранен в Kafka" vertex="1">
          <mxGeometry height="70" width="230" x="110" y="1000" as="geometry" />
        </mxCell>
        <mxCell id="comment4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=10;align=left;verticalAlign=top;dashed=1" value="💡 Kafka Guarantees:&#xa;• Partitioning: по insurance_company_id&#xa;• Ordering: внутри партиции гарантирован&#xa;• Retention: products 30d, policies 365d&#xa;• Replication: 3 replicas для HA" vertex="1">
          <mxGeometry height="70" width="230" x="630" y="1000" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#37474F;fontSize=12;fontStyle=1;align=center" value="ЛЕГЕНДА" vertex="1">
