        <mxCell id="legend3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=10;align=center" value="📤 Outbox Publisher  📥 Event Consumer  📋 Local Replica" vertex="1">
          <mxGeometry height="25" width="400" x="1230" y="1100" as="geometry" />
