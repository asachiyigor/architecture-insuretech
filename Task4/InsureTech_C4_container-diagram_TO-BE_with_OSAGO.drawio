          <mxGeometry height="25" width="280" x="1690" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="summary" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0277BD;fontSize=11;fontStyle=1;align=left;verticalAlign=top;strokeWidth=3" value="НОВОЕ В OSAGO (Task4):&#xa;&#xa;✅ osago-aggregator: parallel aggregation от 5 компаний&#xa;✅ Real-time SSE: стриминг результатов расчета в UI&#xa;✅ Redis: state management (session, cache, rate limit)&#xa;✅ Resilience Patterns:&#xa;   🔄 Retry with exponential backoff&#xa;   🛡️ Circuit Breaker (защита от сбоев)&#xa;   ⏱️ Timeout (2s per company, 5s total)&#xa;   🚦 Rate Limiting (100 req/min)&#xa;✅ Graceful degradation: fallback to cache" vertex="1">
          <mxGeometry height="160" width="450" x="40" y="1050" as="geometry" />
